# Base URL of the Oceana server the SPA talks to (REST under /api, SignalR under /hubs).
# Copy this file to `.env.local` and adjust if your server runs elsewhere.
#
# The server pins Kestrel to http://localhost:5069 in appsettings.json, and that
# takes precedence over the launch profile's URL — so the server listens on 5069
# whether it is started with `dotnet run` or as the built DLL. This default
# therefore works out of the box (see src/shared/api/config.ts).
VITE_API_BASE_URL=http://localhost:5069
